<%
  # Fase 12b (SDD §17.5): un dominio por audiencia, sin toggle — @segmento ya
  # viene fijo del controller (derivado del subdominio, no del usuario).
  entrenador = @segmento == "entrenador"

  copy = entrenador ? {
    eyebrow: "Autoservicio para entrenadores · sin comercializador, sin espera",
    titulo: "Lleva la plataforma a tu propio negocio",
    subtitulo: "Tu marca, tu subdominio, tus clientes. Planes de entrenamiento y " \
                "nutrición con IA, seguimiento en tiempo real y todo lo que ya usan " \
                "nuestros gimnasios — ahora en tu propio panel.",
    cta: "Quiero mi propio negocio",
    precio_eyebrow: "Para entrenadores",
    precio_titulo: "Tu propia marca, tu propio subdominio",
    precio: "49.900",
    precio_detalle: "los primeros 3 meses · luego $99.900/mes de lista",
    precio_ancla: "Menos que una mensualidad de gimnasio.",
    beneficios: [
      "Tu subdominio y tu marca, no la nuestra",
      "Gestiona a tus clientes desde un solo panel",
      "Planes de entrenamiento y nutrición con IA",
      "Seguimiento de progreso, rachas y récords"
    ]
  } : {
    eyebrow: "Autoservicio · entrena por tu cuenta",
    titulo: "Entrena con IA, sin gimnasio ni entrenador",
    subtitulo: "Un plan de entrenamiento y nutrición hecho para ti, seguimiento de " \
                "tu progreso en tiempo real y la misma tecnología que ya usan " \
                "nuestros gimnasios — para que entrenes por tu cuenta.",
    cta: "Quiero entrar",
    precio_eyebrow: "Para ti",
    precio_titulo: "Sin gimnasio ni entrenador detrás",
    precio: "29.900",
    precio_detalle: "o gratis con las guías básicas, sin IA",
    precio_ancla: "Menos que otras apps de entrenamiento con IA.",
    beneficios: [
      "Plan de entrenamiento y nutrición personalizado con IA",
      "Registra tus comidas, pesos y series",
      "Progreso, rachas y récords personales",
      "Cancela cuando quieras"
    ]
  }
%>
<% content_for :title, "#{copy[:titulo]} — Advance Fitness" %>

<%# ── HERO ───────────────────────────────────────────────────────────────── %>
<section class="gradient-hero relative overflow-hidden">
  <div class="trama-puntos absolute inset-0 opacity-30"></div>
  <div class="relative mx-auto flex max-w-4xl flex-col items-center gap-6 px-6 py-20 text-center">
    <p class="eyebrow text-volt"><%= copy[:eyebrow] %></p>
    <h1 class="font-display text-4xl font-bold text-white sm:text-5xl"><%= copy[:titulo] %></h1>
    <p class="mt-2 max-w-2xl text-lg text-white/70"><%= copy[:subtitulo] %></p>

    <%= link_to copy[:cta], "#solicitud", class: "btn btn-primary btn-lg mt-2 gap-2 px-10 font-bold shadow-xl" %>
    <p class="text-sm text-white/40">Sin tarjeta. Sin contratos. Te contactamos nosotros.</p>
  </div>
</section>

<%# ── PRECIO ─────────────────────────────────────────────────────────────── %>
<section class="mx-auto max-w-lg px-6 py-16 text-center">
  <p class="eyebrow text-volt">Precio de lanzamiento</p>
  <div class="card mt-6 border-2 border-volt bg-base-100 shadow-md">
    <div class="card-body gap-4">
      <div>
        <p class="eyebrow text-volt"><%= copy[:precio_eyebrow] %></p>
        <h2 class="font-display text-xl font-bold"><%= copy[:precio_titulo] %></h2>
      </div>
      <div>
        <p class="font-display text-5xl font-bold">
          $<%= copy[:precio] %> <span class="text-lg font-normal text-steel-5">COP/mes</span>
        </p>
        <p class="text-sm text-steel-3"><%= copy[:precio_detalle] %></p>
        <p class="mt-2 text-sm font-semibold text-volt"><%= copy[:precio_ancla] %></p>
      </div>
      <ul class="flex flex-col gap-2 text-left text-sm text-steel-5">
        <% copy[:beneficios].each do |beneficio| %>
          <li>✓ <%= beneficio %></li>
        <% end %>
      </ul>
      <%= link_to copy[:cta], "#solicitud", class: "btn btn-primary mt-2 font-bold" %>
    </div>
  </div>
</section>

<%# ── FEATURES ───────────────────────────────────────────────────────────── %>
<section class="bg-base-200 px-6 py-16">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-display text-center text-2xl font-bold">Todo lo que ya construimos, en tu bolsillo</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <% [
        ["🧠", "IA de entrenamiento y nutrición", "Rutina y plan de comidas diseñados para el objetivo, el cuerpo y los gustos de cada persona."],
        ["📈", "Progreso en tiempo real", "Peso, calorías, series y cargas — todo registrado en segundos, sin digitar de más."],
        ["🏆", "Rachas, logros y récords", "Gamificación que mantiene a la gente entrenando: rachas, récords personales y celebraciones."],
        ["👥", "Muro de comunidad", entrenador ? "Los logros de tus clientes, visibles entre ellos — con opt-in explícito de cada persona." : "Los logros de otros como tú, visibles para animarte — con opt-in explícito de cada persona."],
        ["📱", "App instalable en el celular", "Pensada mobile-first, funciona como una app nativa desde el navegador."],
        ["🔒", "Tus datos, aislados", "Cada negocio (o persona) vive en su propio espacio — nada se mezcla con nadie más."]
      ].each do |emoji, titulo, detalle| %>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <span class="text-3xl"><%= emoji %></span>
            <h3 class="font-semibold"><%= titulo %></h3>
            <p class="text-sm text-steel-5"><%= detalle %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ── FORMULARIO ─────────────────────────────────────────────────────────── %>
<section id="solicitud" class="mx-auto max-w-lg px-6 py-16">
  <h2 class="font-display text-center text-2xl font-bold">Cuéntanos y te contactamos</h2>
  <p class="mt-2 text-center text-sm text-steel-5">
    Sin pasarela de pago todavía — dejas tus datos y en menos de 24h te escribimos para activar tu cuenta.
  </p>

  <% if @solicitud.errors.any? %>
    <div role="alert" class="alert alert-error mt-6 text-sm">
      <%= render "shared/icono", nombre: :alerta, clase: "size-5 shrink-0" %>
      <span><%= @solicitud.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <%= form_with model: @solicitud, url: landing_autoservicios_path, class: "mt-6 flex flex-col gap-4" do |form| %>
    <label class="form-control">
      <span class="label-text mb-1 text-xs font-semibold">Nombre</span>
      <%= form.text_field :nombre, class: "input input-bordered w-full", required: true %>
    </label>
    <label class="form-control">
      <span class="label-text mb-1 text-xs font-semibold">Correo</span>
      <%= form.email_field :email, class: "input input-bordered w-full", required: true %>
    </label>
    <label class="form-control">
      <span class="label-text mb-1 text-xs font-semibold">WhatsApp o teléfono</span>
      <%= form.telephone_field :telefono, class: "input input-bordered w-full", required: true %>
    </label>
    <% if entrenador %>
      <label class="form-control">
        <span class="label-text mb-1 text-xs font-semibold">Nombre de tu negocio o marca</span>
        <%= form.text_field :negocio_nombre, class: "input input-bordered w-full", required: true %>
      </label>
    <% end %>
    <label class="form-control">
      <span class="label-text mb-1 text-xs font-semibold">Cuéntanos qué necesitas (opcional)</span>
      <%= form.text_area :mensaje, class: "textarea textarea-bordered w-full", rows: 3 %>
    </label>

    <%= form.submit copy[:cta], class: "btn btn-primary btn-lg mt-2 font-bold" %>
  <% end %>
</section>

<%# ── FAQ ────────────────────────────────────────────────────────────────── %>
<section class="px-6 pb-20">
  <div class="mx-auto max-w-2xl">
    <h2 class="font-display text-center text-2xl font-bold">Preguntas frecuentes</h2>
    <div class="mt-8 flex flex-col gap-3">
      <% preguntas = [
        ["¿Necesito tarjeta de crédito para empezar?", "No. Dejas tus datos en el formulario y nosotros te contactamos para activar tu cuenta y coordinar el pago."],
        ["¿Cuánto tarda en activarse mi cuenta?", "Menos de 24 horas desde que recibimos tu solicitud."],
        ["¿Puedo cancelar cuando quiera?", "Sí, sin contratos ni permanencia mínima."]
      ]
      preguntas << if entrenador
        ["¿Mis clientes ven mi marca o la de Advance Fitness?", "La tuya. Tu subdominio propio, tu logo, tus colores — la plataforma queda detrás."]
      else
        ["¿Necesito pertenecer a un gimnasio o tener entrenador?", "No. Entrenas por tu cuenta, con tu propio plan generado por IA y tu seguimiento — nadie más de por medio."]
      end %>
      <% preguntas.each do |pregunta, respuesta| %>
        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title text-sm font-semibold"><%= pregunta %></summary>
          <div class="collapse-content text-sm text-steel-5"><p><%= respuesta %></p></div>
        </details>
      <% end %>
    </div>
  </div>
</section>
