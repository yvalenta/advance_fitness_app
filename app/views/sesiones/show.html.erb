<%# Modo sesión (Fase 14.3): pantalla inmersiva de UN ejercicio a la vez con
    cronómetro de descanso y resumen final. Autocontenida: los datos van en el
    <script> JSON y toda la máquina de estados vive en sesion_controller.js. %>
<% content_for :title, "Sesión de entrenamiento" %>

<% if @plan.nil? %>
  <%= render "sesiones/vacio", titulo: "Aún no tienes un plan",
        mensaje: "Cuando tu plan de entrenamiento esté publicado podrás entrenar aquí, guiado ejercicio por ejercicio." %>
<% elsif @movido_hacia %>
  <%= render "sesiones/movido", movido_hacia: @movido_hacia %>
<% elsif @ejercicios_dia.empty? %>
  <%= render "sesiones/vacio", titulo: "Hoy toca descanso",
        mensaje: "El #{l @fecha, format: "%A %d de %B"} no tiene ejercicios programados. Recuperarse también es entrenar." %>
<% else %>
  <section class="mx-auto flex w-full max-w-lg flex-col gap-4 px-4 py-4"
           data-controller="sesion wake-lock"
           data-sesion-registro-url-value="<%= registros_entrenamiento_path %>"
           <%# Registro cuantitativo por serie (Fase 18l): solo premium — sin
               la URL el Stimulus no envía nada y los chips quedan visuales. %>
           data-sesion-detalles-url-value="<%= detalles_entrenamiento_path if Current.user.premium? %>"
           data-sesion-salida-url-value="<%= mi_plan_path %>"
           <%# Wake Lock (Fase 19d): pantalla activa mientras dura la sesión —
               apagable en Ajustes. %>
           data-wake-lock-activo-value="<%= Current.user.wake_lock_activo? %>">
    <script type="application/json" data-sesion-target="datos"><%= raw json_escape(@datos.to_json) %></script>
    <%# Destino de la celebración de PRs (Fase 18n): el create de series
        appendea aquí su toast (fixed — flota sobre lo que sea) cuando una
        serie registrada rompe un récord. %>
    <div id="celebraciones_sesion"></div>

    <%# ── Barra de avance (volt sobre steel) + salida ── %>
    <header class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="text-xs font-bold uppercase tracking-widest text-steel-3">
          <span data-sesion-target="progresoTexto">Ejercicio 1 de <%= @ejercicios_dia.size %></span>
        </p>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-steel">
          <div class="h-full rounded-full bg-volt transition-all duration-300"
               data-sesion-target="progresoBarra" style="width: <%= (100.0 / @ejercicios_dia.size).round(1) %>%"></div>
        </div>
        <% if @dia["enfoque"].present? %>
          <p class="mt-1 truncate text-xs text-steel-3"><%= @dia["enfoque"] %></p>
        <% end %>
      </div>
      <%= link_to mi_plan_path, class: "btn btn-ghost btn-sm btn-circle shrink-0",
            aria: { label: "Salir de la sesión" } do %>
        <%= render "shared/icono", nombre: :salir, clase: "size-5" %>
      <% end %>
    </header>

    <%# Reprogramado hacia aquí (Fase 19e): el contenido no es del día que se
        está viendo, es el de la fecha original movida. %>
    <% if @movido_desde %>
      <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl bg-ocean/10 px-3 py-2.5 text-xs text-ocean">
        <span>Este es el entrenamiento del <%= l @movido_desde.fecha_original, format: :long %>, movido aquí.</span>
        <%= button_to "Deshacer", reprogramacion_dia_path(@movido_desde), method: :delete, class: "btn btn-ghost btn-xs" %>
      </div>
    <% end %>

    <%# Mensaje de fase del ciclo (14.16): solo con consentimiento vigente —
        sin él la fase es :desconocida y el mensaje es nil. Los números de la
        sesión ya vienen compuestos desde el controller. %>
    <% if @ajuste_ciclo["mensaje"] %>
      <div class="flex items-start gap-2 rounded-xl bg-ocean/10 px-3 py-2.5">
        <%= render "shared/icono", nombre: :actividad, clase: "mt-0.5 size-4 shrink-0 text-ocean" %>
        <p class="text-xs leading-snug text-ocean"><%= @ajuste_ciclo["mensaje"] %></p>
      </div>
    <% end %>

    <% @ejercicios_dia.each_with_index do |ejercicio, indice| %>
      <%= render "sesiones/ejercicio", ejercicio: ejercicio, indice: indice,
            total: @ejercicios_dia.size, catalogo: @catalogo %>
    <% end %>

    <%= render "sesiones/descanso" %>
    <%= render "sesiones/resumen", fecha: @fecha %>

    <%# Reprogramar este día (Fase 19e): no se ofrece sobre un día ya movido
        hacia aquí — un día se mueve una vez, no se encadena. %>
    <% unless @movido_desde %>
      <details class="rounded-xl border border-base-300 bg-base-100 p-3">
        <summary class="cursor-pointer text-xs font-semibold text-steel-3">¿No puedes hoy? Reprograma este día</summary>
        <%= form_with url: reprogramaciones_dia_path, method: :post, class: "mt-2 flex flex-wrap items-end gap-2" do |form| %>
          <%= form.hidden_field "fecha_original", value: @fecha.iso8601 %>
          <label class="form-control">
            <span class="label-text mb-1 text-xs">Mover al</span>
            <%= form.date_field "fecha_destino", min: Date.current.iso8601, required: true, class: "input input-bordered input-sm" %>
          </label>
          <%= form.submit "Mover", class: "btn btn-primary btn-sm font-bold" %>
        <% end %>
      </details>
    <% end %>
  </section>
<% end %>
