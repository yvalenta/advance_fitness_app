<%# Panel de un día completo de la rutina unificada (Fase 6.8): cada ejercicio %>
<%# lleva un bloque de LECTURA (checks, cápsulas, ayuda) y uno de EDICIÓN %>
<%# (inputs), hermanos que "modo-edicion" alterna sin duplicar el componente. %>
<%# Conserva su id y data-dia-url: GestionDiasController los usa como turbo_ %>
<%# stream replace target y modal_ejercicios#abrir/#aplicarSesion los usan %>
<%# para ubicar el día destino. %>
<%# Fase 14.9: el id y las URLs llevan la semana del mesociclo — el registro %>
<%# y la fecha del seguimiento se resuelven por semana (Rutina::Calendario). %>
<%# locals: (plan:, dia:, indice:, semana: 1, con_seguimiento: false, editable: false, editando_por_defecto: false, registro: nil, fecha: nil, anteriores: {}, premium: nil, mensaje_ciclo: nil) %>
<% semana = local_assigns.fetch(:semana, 1) %>
<% con_seguimiento = local_assigns.fetch(:con_seguimiento, false) %>
<% editable = local_assigns.fetch(:editable, false) %>
<% editando_por_defecto = local_assigns.fetch(:editando_por_defecto, false) %>
<% registro = local_assigns[:registro] %>
<% fecha = local_assigns[:fecha] %>
<%# {ejercicio_id => última serie registrada} — lo calcula el controller en
    UNA query (Fase 14.2); aquí está prohibido consultar (N+1 por fila). %>
<% anteriores = local_assigns[:anteriores] || {} %>
<% futuro = con_seguimiento && fecha && fecha > Date.current %>
<% ejercicios = Array(dia["ejercicios"]) %>

<div id="dia_editor_<%= semana %>_<%= indice %>" class="flex flex-col gap-2.5"
     data-semana="<%= semana %>"
     data-fecha="<%= fecha.iso8601 if con_seguimiento %>"
     data-dia-url="<%= plan_personalizado_dia_path(plan, indice, semana: semana) if editable %>">

  <% if dia["enfoque"].present? %>
    <div class="flex flex-wrap items-center gap-2 rounded-xl bg-volt/10 px-3 py-2"
         data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>>
      <%= render "shared/icono", nombre: :rayo, clase: "size-4 shrink-0 text-volt-d" %>
      <p class="min-w-0 text-sm font-semibold text-base-content/80"><span class="text-steel-3">Enfoque:</span> <%= dia["enfoque"] %></p>
      <% if con_seguimiento && !futuro %>
        <span class="ml-auto shrink-0 text-xs text-steel-3"><%= l fecha, format: "%d %b" %></span>
      <% end %>
    </div>
  <% end %>

  <% if mensaje_ciclo %>
    <%# Fase del ciclo (14.16): informa sin alterar los valores editables %>
    <div class="flex items-start gap-2 rounded-xl bg-ocean/10 px-3 py-2.5"
         data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>>
      <%= render "shared/icono", nombre: :actividad, clase: "mt-0.5 size-4 shrink-0 text-ocean" %>
      <p class="text-xs leading-snug text-ocean"><%= mensaje_ciclo %></p>
    </div>
  <% end %>

  <%# Hero media del día (pulido 14.17, referencia Gymnax): el GIF del primer
      ejercicio en grande, tap = abrir su guía de ejecución. Solo lectura y
      solo para el seguimiento del miembro — el editor del staff no lo carga. %>
  <% hero = con_seguimiento && ejercicios.find { |e| e["ejercicio_id"].present? } %>
  <% if hero %>
    <button type="button" class="group relative block w-full overflow-hidden rounded-2xl bg-white/95"
            data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>
            data-action="click->ayuda-ejercicio#abrir"
            data-ayuda-url="<%= ayuda_ejercicios_path(ejercicio_id: hero["ejercicio_id"], nombre: hero["nombre"]) %>"
            aria-label="Ver ejecución de <%= hero["nombre"] %>">
      <img src="<%= media_ejercicio_path(hero["ejercicio_id"], tipo: :gif) %>" loading="lazy"
           class="aspect-video w-full object-contain" alt="<%= hero["nombre"] %>">
      <span class="absolute inset-0 bg-gradient-to-t from-steel-9/70 via-transparent to-transparent"></span>
      <span class="absolute bottom-2 left-3 right-3 flex items-center gap-2 text-left">
        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-volt text-steel-9 shadow-lg transition-transform group-hover:scale-110">
          <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="min-w-0 truncate text-sm font-bold text-white drop-shadow"><%= hero["nombre"] %></span>
      </span>
    </button>
  <% end %>

  <% if editable %>
    <label class="input input-sm input-bordered flex items-center gap-2"
           data-modo-edicion-target="edicion" <%= "hidden" unless editando_por_defecto %>
           data-autosave-target="card" data-clave="dia" data-url="<%= plan_personalizado_dia_path(plan, indice, semana: semana) %>">
      <span class="text-xs font-bold text-steel-3">Enfoque</span>
      <input type="text" name="dia[enfoque]" value="<%= dia["enfoque"] %>" class="grow"
             aria-label="Enfoque del día" data-action="input->autosave#programar">
      <span class="badge badge-sm gap-1 font-semibold" hidden
            data-autosave-target="estado" data-action="click->autosave#reintentar"></span>
    </label>
  <% end %>

  <% if ejercicios.any? %>
    <% ejercicios.each_with_index do |ejercicio, ei| %>
      <% hecho = con_seguimiento && registro&.estado_de(uid: ejercicio["uid"], indice: ei)&.dig("hecho") %>
      <div class="flex flex-col gap-2 rounded-xl border p-3 transition-colors <%= hecho ? "border-success/50 bg-success/5" : "border-base-300 bg-base-100 hover:border-volt-d/40 hover:bg-base-200/50" %>"
           <% if editable %>data-autosave-target="card" data-url="<%= plan_personalizado_dia_ejercicio_path(plan, indice, ei, semana: semana) %>"<% end %>
           data-indice="<%= ei %>" data-uid="<%= ejercicio["uid"] %>" data-nombre="<%= ejercicio["nombre"] %>">

        <%# ── Lectura (Fase 14.2, referencia Gymnax): miniatura, nombre + línea
            densa única, "la vez pasada" y check circular al extremo derecho ── %>
        <div class="flex items-center gap-3" data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>>
          <% if ejercicio["ejercicio_id"].present? %>
            <img src="<%= media_ejercicio_path(ejercicio["ejercicio_id"], tipo: :imagen) %>" loading="lazy"
                 width="56" height="56" class="size-14 shrink-0 rounded-xl bg-white/90 object-cover"
                 alt="<%= ejercicio["nombre"] %>">
          <% else %>
            <span class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-base-200 font-display text-base font-bold text-steel-5">
              <%= ei + 1 %>
            </span>
          <% end %>
          <button type="button" class="min-w-0 flex-1 text-left"
                  data-action="click->ayuda-ejercicio#abrir"
                  data-ayuda-url="<%= ayuda_ejercicios_path(ejercicio_id: ejercicio["ejercicio_id"], nombre: ejercicio["nombre"]) %>">
            <p class="flex items-center gap-1.5 font-semibold leading-tight">
              <span class="min-w-0"><%= ejercicio["nombre"] %></span>
              <%= render "shared/icono", nombre: :busqueda, clase: "size-3.5 shrink-0 text-steel-3" %>
            </p>
            <p class="mt-0.5 text-sm">
              <span class="whitespace-nowrap font-bold text-volt-d"><%= ejercicio["series"] %> × <%= repeticiones_texto(ejercicio) %></span>
              <% if ejercicio["peso_sugerido_kg"].to_f.positive? %>
                <%# Peso inicial sugerido por el análisis del perfil (Fase 6.5) %>
                <span class="whitespace-nowrap text-steel-3">· ≈<%= ejercicio["peso_sugerido_kg"] %> kg</span>
              <% end %>
              <% if ejercicio["descanso_seg"].to_i.positive? %>
                <span class="whitespace-nowrap text-steel-3">· <%= ejercicio["descanso_seg"] %> s</span>
              <% end %>
              <% if ejercicio["grupo_superserie"].present? %>
                <span class="whitespace-nowrap text-ocean">· ⚡ superserie</span>
              <% end %>
            </p>
            <% if (anterior = anteriores[ejercicio["ejercicio_id"]]) %>
              <p class="mt-0.5 text-xs text-ocean">
                Anterior: <%= anterior.peso_kg.present? ? "#{number_with_precision(anterior.peso_kg, precision: 1, strip_insignificant_zeros: true)} kg × #{anterior.repeticiones}" : "#{anterior.repeticiones} reps" %>
              </p>
            <% end %>
            <% if ejercicio["nota_tecnica"].present? %>
              <p class="mt-1 text-xs leading-snug text-steel-3"><%= ejercicio["nota_tecnica"] %></p>
            <% end %>
          </button>
          <%# El botón "Registrar" salió de la tarjeta (Fase 18l, decisión del
              cliente): las series reales se capturan en el modo sesión al
              marcar cada chip — aquí queda solo el check de seguimiento. %>
          <% if con_seguimiento %>
            <%# Check circular a la derecha (patrón has-checked de _plan): el
                input sigue siendo el mismo checkbox de seguimiento#marcar. %>
            <label class="group shrink-0 <%= futuro ? "cursor-not-allowed" : "cursor-pointer" %>">
              <input type="checkbox" class="sr-only"
                     <%= "checked" if hecho %> <%= "disabled" if futuro %>
                     aria-label="¿Hiciste <%= ejercicio["nombre"] %>?"
                     data-action="change->seguimiento#marcar">
              <span class="flex size-8 items-center justify-center rounded-full border-2 border-base-300 text-transparent transition-colors group-has-[:checked]:border-success group-has-[:checked]:bg-success group-has-[:checked]:text-white <%= "opacity-40" if futuro %>">
                <%= render "shared/icono", nombre: :check, clase: "size-4" %>
              </span>
            </label>
          <% end %>
        </div>

        <%# ── Edición: campos inline (Fase 5.7b/6.5) ─────────────────────── %>
        <% if editable %>
          <div class="flex flex-col gap-2" data-modo-edicion-target="edicion" <%= "hidden" unless editando_por_defecto %>>
            <div class="flex items-center gap-2">
              <%# Enlace al catálogo visual (Fase 6.4): lo fija el modal al aplicar %>
              <input type="hidden" name="ejercicio[ejercicio_id]" value="<%= ejercicio["ejercicio_id"] %>">
              <input type="text" name="ejercicio[nombre]" value="<%= ejercicio["nombre"] %>" required
                     class="input input-sm input-bordered w-full font-semibold" aria-label="Ejercicio"
                     data-action="input->autosave#programar">
              <span class="badge badge-sm shrink-0 gap-1 font-semibold" hidden
                    data-autosave-target="estado" data-action="click->autosave#reintentar"></span>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Series</span>
                <input type="number" name="ejercicio[series]" value="<%= ejercicio["series"] %>" min="0"
                       class="w-full text-right" aria-label="Series" data-action="input->autosave#programar">
              </label>
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Reps</span>
                <input type="text" name="ejercicio[repeticiones]" value="<%= ejercicio["repeticiones"] %>"
                       class="w-full text-right" aria-label="Repeticiones" data-action="input->autosave#programar">
              </label>
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Desc.</span>
                <input type="number" name="ejercicio[descanso_seg]" value="<%= ejercicio["descanso_seg"] %>" min="0"
                       class="w-full text-right" aria-label="Descanso (s)" data-action="input->autosave#programar">
                <span class="text-xs text-steel-3">s</span>
              </label>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-2">
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">≈ kg</span>
                <input type="number" name="ejercicio[peso_sugerido_kg]" value="<%= ejercicio["peso_sugerido_kg"] %>"
                       min="0" step="0.5" class="w-full text-right" aria-label="Peso sugerido (kg)"
                       data-action="input->autosave#programar">
              </label>
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Nota</span>
                <input type="text" name="ejercicio[nota_tecnica]" value="<%= ejercicio["nota_tecnica"] %>" maxlength="90"
                       placeholder="Consejo de ejecución (opcional)" class="grow" aria-label="Nota técnica"
                       data-action="input->autosave#programar">
              </label>
            </div>
            <%# Fase 20: tipo (reps/tiempo), superserie (par sin descanso entre sí)
                y unilateral (por lado) — nunca los escribe la IA (Nota 27). %>
            <div class="grid grid-cols-[6rem_1fr_5.5rem] gap-2">
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Tipo</span>
                <select name="ejercicio[tipo]" class="grow bg-transparent text-right text-xs"
                        aria-label="Tipo de ejercicio" data-action="change->autosave#programar">
                  <option value="reps" <%= "selected" if ejercicio["tipo"] != "tiempo" %>>Reps</option>
                  <option value="tiempo" <%= "selected" if ejercicio["tipo"] == "tiempo" %>>Tiempo</option>
                </select>
              </label>
              <label class="input input-sm input-bordered flex items-center gap-1">
                <span class="text-xs font-bold text-steel-3">Superserie</span>
                <input type="text" name="ejercicio[grupo_superserie]" value="<%= ejercicio["grupo_superserie"] %>"
                       placeholder="ej. A1" maxlength="20" class="w-full" aria-label="Grupo de superserie"
                       data-action="input->autosave#programar">
              </label>
              <label class="input input-sm input-bordered flex cursor-pointer items-center justify-center gap-1.5">
                <input type="checkbox" name="ejercicio[unilateral]" <%= "checked" if ejercicio["unilateral"] %>
                       class="checkbox checkbox-xs" aria-label="Unilateral, por lado"
                       data-action="change->autosave#programar">
                <span class="text-xs font-bold text-steel-3">Por lado</span>
              </label>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button" class="btn btn-ghost btn-xs" data-action="modal-ejercicios#abrir">
                <%= render "shared/icono", nombre: :busqueda, clase: "size-3.5" %> Plantilla
              </button>
              <% if Current.user.staff? %>
                <button type="button" class="btn btn-ghost btn-xs text-steel-5"
                        data-action="modal-ejercicios#guardarPlantilla" data-musculo="otro">
                  Guardar como plantilla
                </button>
              <% end %>
              <button type="button" class="btn btn-ghost btn-xs ml-auto text-error"
                      data-action="autosave#eliminar" aria-label="Eliminar ejercicio">
                <%= render "shared/icono", nombre: :papelera, clase: "size-3.5" %>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="rounded-xl bg-base-200 px-3 py-4 text-center text-sm text-steel-3"
       data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>>Día de descanso.</p>
  <% end %>

  <% if editable %>
    <button type="button" class="btn btn-outline btn-sm w-full border-dashed"
            data-modo-edicion-target="edicion" <%= "hidden" unless editando_por_defecto %>
            data-action="autosave#agregar" data-url="<%= plan_personalizado_dia_ejercicios_path(plan, indice, semana: semana) %>">
      + Agregar ejercicio
    </button>
  <% end %>

  <% if con_seguimiento %>
    <%# Novedad para toda la rutina del día (lesión, cambio de máquina…) %>
    <input type="text" placeholder="Novedad del día para toda la rutina (opcional)" maxlength="160"
           value="<%= registro&.novedad %>" <%= "disabled" if futuro %>
           class="input input-bordered input-sm w-full"
           data-modo-edicion-target="lectura" <%= "hidden" if editando_por_defecto %>
           data-action="change->seguimiento#novedad">
  <% end %>
</div>
