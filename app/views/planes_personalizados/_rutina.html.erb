<%# Rutina semanal unificada (Fase 6.8) + eje de semanas del mesociclo (Fase %>
<%# 14.9): una sola tarjeta que alterna, por ejercicio, entre modo lectura %>
<%# (checks de seguimiento, cápsulas) y modo edición (inputs inline). Con un %>
<%# plan multisemana la tarjeta apila una sección por semana (etiqueta + barra %>
<%# de progreso volt/steel + chips de día); SOLO la semana activa vive en el %>
<%# DOM inicial — las demás son turbo-frames perezosos (GestionSemanas) que el %>
<%# mesociclo_controller destapa al seleccionarlas. Los tabs de día viven %>
<%# DENTRO de cada semana (_semana), nunca anidados bajo otro "tabs". Un plan %>
<%# v1 (una sola semana) se ve igual que siempre: sin eje. %>
<%# locals: (rutina:, plan: nil, usuario: nil, plantillas: nil, siempre_editando: false) %>
<% plan = local_assigns[:plan] %>
<% usuario = local_assigns[:usuario] %>
<% siempre_editando = local_assigns.fetch(:siempre_editando, false) %>
<% semanas = plan ? plan.semanas : [] %>
<% multisemana = semanas.size > 1 %>
<% activa = plan ? plan.semana_actual : 1 %>
<% con_seguimiento = plan && usuario && plan.user_id == usuario.id %>
<% editable = siempre_editando || (plan && usuario && PlanPersonalizadoPolicy.new(usuario, plan).editar_rutina?) %>
<% plantillas = local_assigns[:plantillas] || (PlantillaEjercicio.ordenadas if editable) %>
<% if multisemana %>
  <%# Progreso por semana: UNA query de registros para todo el mesociclo. %>
  <% dias_por_semana = semanas.to_h { |s| [ s["numero"], plan.dias(semana: s["numero"]) ] } %>
  <% fechas_por_semana = dias_por_semana.to_h do |n, dias_semana|
       [ n, dias_semana.each_index.map { |i| Rutina::Calendario.fecha_de(plan, semana: n, dia_indice: i) } ]
     end %>
  <% registros_mesociclo = con_seguimiento ? usuario.registros_entrenamiento.where(fecha: fechas_por_semana.values.flatten).index_by(&:fecha) : {} %>
  <% progreso = dias_por_semana.to_h do |n, dias_semana|
       total = hechos = 0
       estados = dias_semana.each_index.map do |i|
         ejercicios = Array(dias_semana[i]["ejercicios"])
         total += ejercicios.size
         registro = registros_mesociclo[fechas_por_semana[n][i]]
         hechos_dia = ejercicios.each_index.count { |ei| registro&.estado_de(ei)&.dig("hecho") }
         hechos += hechos_dia
         ejercicios.any? && hechos_dia == ejercicios.size
       end
       [ n, { total: total, hechos: hechos, estados: estados } ]
     end %>
<% end %>

<div class="card border border-base-300 bg-base-100 shadow-md"
     data-controller="<%= "mesociclo " if multisemana %>modo-edicion seguimiento ayuda-ejercicio registro-series autosave modal-ejercicios"
     <% if multisemana %>data-mesociclo-activa-value="<%= activa %>"<% end %>
     data-seguimiento-url-value="<%= registros_entrenamiento_path %>"
     data-autosave-clave="ejercicio"
     data-modal-ejercicios-crear-url="<%= entrenador_plantillas_ejercicio_path %>"
     data-modo-edicion-editando-value="<%= siempre_editando %>">
  <div class="card-body">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="card-title text-base">
        <span class="flex size-7 items-center justify-center rounded-lg bg-volt/15 text-volt-d">
          <%= render "shared/icono", nombre: :actividad, clase: "size-4" %>
        </span>
        Rutina semanal
      </h2>
      <div class="flex items-center gap-2">
        <% if con_seguimiento %>
          <span class="text-xs text-steel-3" data-modo-edicion-target="lectura" <%= "hidden" if siempre_editando %>>
            Marca lo que ejecutes · <span data-seguimiento-target="estado"></span>
          </span>
        <% end %>
        <% if editable %>
          <span class="text-xs text-steel-3" data-autosave-target="global" data-modo-edicion-target="edicion"
                <%= "hidden" unless siempre_editando %>>Todo guardado ✓</span>
        <% end %>
        <% if editable && !siempre_editando %>
          <button type="button" class="btn btn-ghost btn-xs gap-1 font-semibold"
                  data-action="modo-edicion#alternar" data-modo-edicion-target="boton">
            <%= render "shared/icono", nombre: :lapiz, clase: "size-3.5" %> Editar
          </button>
        <% end %>
      </div>
    </div>

    <% if editable && plan&.reglas? %>
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-success gap-1 font-semibold">
          <%= render "shared/icono", nombre: :check, clase: "size-3" %> Incluido con tu membresía
        </span>
        <span class="text-xs text-steel-5">Personaliza tu rutina: cambia los músculos del día y elige ejercicios de la biblioteca.</span>
      </div>
    <% end %>

    <% if multisemana %>
      <div class="mt-1 flex flex-wrap items-center justify-between gap-2">
        <p class="eyebrow text-steel-3">Programa · <%= semanas.size %> semanas</p>
        <% if plan.mesociclo_completado? %>
          <span class="badge badge-success badge-sm gap-1 font-semibold">
            <%= render "shared/icono", nombre: :check, clase: "size-3" %> Mesociclo completado
          </span>
        <% end %>
      </div>

      <% semanas.each do |s| %>
        <% n = s["numero"] %>
        <% es_activa = n == activa %>
        <section class="rounded-2xl border p-3 transition-colors <%= es_activa ? "border-volt-d/60" : "border-base-300" %>"
                 data-mesociclo-target="semana" data-numero="<%= n %>"
                 data-hechos="<%= progreso[n][:hechos] %>" data-total="<%= progreso[n][:total] %>">
          <button type="button" class="flex w-full flex-wrap items-center gap-2 text-left"
                  data-action="mesociclo#seleccionar">
            <span class="font-display text-sm font-bold uppercase tracking-wide"><%= s["etiqueta"] %></span>
            <% if s["descarga"] %>
              <span class="badge badge-warning badge-xs font-semibold">Descarga</span>
            <% end %>
            <% if plan.semana_materializada?(n) %>
              <span class="badge badge-outline badge-xs font-semibold text-volt-d">Personalizada</span>
            <% end %>
            <span class="ml-auto text-xs font-semibold text-steel-3"><%= progreso[n][:hechos] %>/<%= progreso[n][:total] %></span>
          </button>
          <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-base-300">
            <div class="h-full rounded-full bg-volt transition-[width] duration-500 ease-out" style="width: 0%"
                 data-mesociclo-target="barra"></div>
          </div>
          <div class="mt-2" data-mesociclo-target="chips" <%= "hidden" if es_activa %>>
            <%= render "planes_personalizados/chips_dias", dias: dias_por_semana[n],
                  estados: progreso[n][:estados], interactivo: false, atenuada: n > activa %>
          </div>
          <% if es_activa %>
            <%= turbo_frame_tag "plan_#{plan.id}_semana_#{n}", class: "mt-2 block" do %>
              <%= render "planes_personalizados/semana", plan: plan, usuario: usuario, numero: n, chips: true,
                    editando_por_defecto: siempre_editando,
                    registros: (registros_mesociclo.slice(*fechas_por_semana[n]) if con_seguimiento) %>
            <% end %>
          <% else %>
            <%= turbo_frame_tag "plan_#{plan.id}_semana_#{n}", class: "mt-2 block", hidden: true, loading: :lazy,
                  src: plan_personalizado_semana_path(plan, n, siempre_editando ? { editor: 1 } : {}) %>
          <% end %>
        </section>
      <% end %>
    <% else %>
      <%= render "planes_personalizados/semana", plan: plan, usuario: usuario, numero: 1, chips: false,
            editando_por_defecto: siempre_editando, dias: (Array(rutina["dias"]) unless plan) %>
    <% end %>
  </div>

  <% if editable %>
    <%= render "planes_personalizados/modal_ejercicios", plantillas: plantillas %>
  <% end %>
  <%= render "ejercicios/dialogo_ayuda" %>
  <% if con_seguimiento && usuario.premium? %>
    <%= render "detalles_entrenamiento/dialogo" %>
  <% end %>
</div>
