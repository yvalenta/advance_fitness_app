<!DOCTYPE html>
<%# data-theme vive en el BODY (Nota 21b): Turbo (replace y morph) solo
    actualiza el body — en <html> cambiar el tema exigiría F5. %>
<html lang="es">
  <head>
    <title><%= content_for(:title) || Negocio.nombre %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Negocio.nombre %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= metas_theme_color %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Turbo 8 morphing (Fase de Calidad): los refreshes actualizan el DOM
        en sitio y conservan el scroll — sin "flash" de página completa. %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%# View transitions (Fase 16.7): cross-fade nativo en visitas de página
        completa donde el navegador lo soporte; los refreshes con morph no
        pasan por aquí, así que no compiten. Progresivo: sin soporte, nada. %>
    <meta name="view-transition" content="same-origin">

    <%= yield :head %>

    <%# PWA manifest (rutas en config/routes.rb). Parametrizado por Negocio/Current.tenant. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tipografía de marca self-hosted (Fase 16.5): variables, 51KB total,
        sin render-blocking de CDN. crossorigin es obligatorio en preload
        de fuentes aunque sean del mismo origen. %>
    <%= preload_link_tag "geist-variable.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag "space-grotesk-variable.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>

    <%# Hojas EXPLÍCITAS (Fase 16.5): el :app de Rails engloba todo css del
        load path — incluía actiontext.css en cada página. Ahora esa hoja va
        por content_for :head solo donde hay rich text (blog, admin posts). %>
    <%= stylesheet_link_tag "application", "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Paleta del tenant (SDD §16.6): overrides de los tokens CSS del tema
        DaisyUI/Tailwind. Solo se aceptan colores hex (#rgb, #rgba, #rrggbb,
        #rrggbbaa) para evitar CSS injection desde el jsonb. %>
    <%= render "shared/paleta_tenant" %>
  </head>

  <%# tag.attributes omite el atributo cuando es nil — clave para "sistema":
      un data-theme="" vacío matchearía [data-theme] y rompería el caso. %>
  <body class="min-h-screen bg-base-200 font-sans text-base-content" <%= tag.attributes("data-theme": tema_data_theme, "data-acento": acento_data) %>>
    <%# Tab bar inferior (Fase 14.1): solo miembros/staff de tenant — los
        roles globales (superadmin/comercializador) no la necesitan. %>
    <% con_tab_bar = Current.user && !Current.user.global? %>
    <% if authenticated? %>
      <%= render "shared/navbar" %>
    <% end %>

    <% if flash[:alert].present? || flash[:notice].present? %>
      <%# pointer-events-none: el contenedor cubre toda la navbar (toast-top
          w-full) pero no debe bloquear sus clics — solo cada caja visible
          (pointer-events-auto) los captura. Se cierra solo a los 5s. %>
      <div class="toast toast-top toast-center z-50 w-full max-w-lg px-4 pt-16 pointer-events-none" data-controller="toast">
        <% if (mensaje = flash[:alert]) %>
          <div role="alert" class="alert alert-error pointer-events-auto shadow-lg" id="alert" data-toast-target="item">
            <%= render "shared/icono", nombre: :alerta, clase: "size-5 shrink-0" %>
            <span class="text-sm font-medium"><%= mensaje %></span>
            <button type="button" class="btn btn-ghost btn-xs btn-circle" data-action="toast#cerrar" aria-label="Cerrar">✕</button>
          </div>
        <% end %>
        <% if (mensaje = flash[:notice]) %>
          <div role="alert" class="alert alert-success pointer-events-auto shadow-lg" id="notice" data-toast-target="item">
            <%= render "shared/icono", nombre: :check, clase: "size-5 shrink-0" %>
            <span class="text-sm font-medium"><%= mensaje %></span>
            <button type="button" class="btn btn-ghost btn-xs btn-circle" data-action="toast#cerrar" aria-label="Cerrar">✕</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# pb-20: el contenido no queda debajo de la tab bar fija en móvil %>
    <main class="<%= "pb-20 md:pb-0" if con_tab_bar %>">
      <%= yield %>
    </main>

    <%= render "shared/tab_bar" if con_tab_bar %>

    <footer class="flex flex-col items-center gap-0.5 py-4 text-center">
      <span class="font-mono text-[10px] text-base-content/40">v<%= Rails.application.config.x.version %></span>
      <span class="font-display text-[9px] font-medium uppercase tracking-[0.2em] text-base-content/25">Ynt-labs</span>
    </footer>

    <%# Confirmación global (Fase 6.9): reemplaza window.confirm/data-turbo-
        confirm, que no hacen nada en iOS con la app agregada a inicio. %>
    <dialog class="modal" data-controller="confirmacion" data-action="click->confirmacion#cerrarEnBackdrop">
      <div class="modal-box max-w-sm">
        <p class="text-sm font-medium" data-confirmacion-target="mensaje"></p>
        <div class="modal-action">
          <button type="button" class="btn btn-ghost btn-sm" data-action="confirmacion#cancelar">Cancelar</button>
          <button type="button" class="btn btn-error btn-sm" data-action="confirmacion#aceptar" data-confirmacion-target="aceptar">Confirmar</button>
        </div>
      </div>
      <div class="modal-backdrop"></div>
    </dialog>
  </body>
</html>
