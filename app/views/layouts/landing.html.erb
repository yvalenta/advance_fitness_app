<!DOCTYPE html>
<%# Las landings de campaña son de marca: SIEMPRE tema oscuro (Nota 21),
    en el body por la misma razón Turbo que el layout principal. %>
<html lang="es">
  <head>
    <title><%= content_for(:title).presence || (@campana&.nombre || "Únete") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="<%= Negocio.theme_color %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%# Tipografía self-hosted (Fase 16.5) — igual que el layout principal %>
    <%= preload_link_tag "geist-variable.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= preload_link_tag "space-grotesk-variable.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>

    <%= render "shared/paleta_tenant" %>
  </head>
  <body class="min-h-screen bg-base-100 font-sans antialiased" data-theme="advance">
    <%= render "shared/toast" if defined?(flash) %>
    <%= yield %>

    <%# Analitica: solo si CF_ANALYTICS_TOKEN esta puesto y solo en produccion.
        Va al final del body para no competir con el render. %>
    <%= beacon_analitica %>
  </body>
</html>
