<%# Novedades públicas para el miembro (Fase 8). Esta vista faltó en el
    release original: el controller y el link del navbar existían, pero
    /novedades reventaba con MissingExactTemplate (Fase de Calidad).
    Fase 18e: además de los anuncios del staff, la página es el muro de la
    comunidad — celebraciones automáticas de PRs/logros de miembros con
    opt-in (consentimiento auditable `logros_comunidad`). %>
<% content_for :title, "Novedades — #{Negocio.nombre}" %>

<%= render "shared/encabezado", titulo: "Novedades",
      descripcion: "Anuncios del gimnasio y logros de la comunidad." %>

<div class="mx-auto -mt-8 flex w-full max-w-3xl flex-col gap-6 px-4 pb-12">
  <% if @novedades.any? %>
    <div class="flex flex-col gap-4">
      <% @novedades.each do |novedad| %>
        <% cache novedad do %>
          <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
            <div class="card-body">
              <% if novedad.fecha_evento %>
                <p class="eyebrow text-volt-d"><%= l novedad.fecha_evento, format: :long %></p>
              <% end %>
              <h2 class="font-display text-lg font-bold"><%= novedad.titulo %></h2>
              <p class="whitespace-pre-line text-sm text-base-content/80"><%= novedad.contenido %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center gap-3 rounded-xl bg-base-200 py-12 text-center">
      <%= render "shared/icono", nombre: :calendario, clase: "size-8 text-steel-1" %>
      <p class="text-sm text-steel-3">No hay anuncios por ahora.</p>
    </div>
  <% end %>

  <%# ── Muro de la comunidad (Fase 18e) ─────────────────────────────────── %>
  <% unless Current.user.global? %>
    <section class="flex flex-col gap-3">
      <h2 class="eyebrow px-1 text-steel-3">Logros de la comunidad</h2>

      <% unless @participo %>
        <div class="card animate-fade-up border-2 border-volt/50 bg-base-100 shadow-md">
          <div class="card-body gap-2">
            <h3 class="card-title text-base">Celebra tus logros con tu gym 💪</h3>
            <p class="text-sm text-steel-5">
              Tus récords y logros aparecerán aquí para motivar a los demás —
              solo tu apodo o nombre de pila, nunca tu correo. Se activa y se
              desactiva cuando quieras.
            </p>
            <%= button_to "Quiero aparecer aquí", novedades_participacion_path,
                  class: "btn btn-primary self-start font-bold" %>
          </div>
        </div>
      <% end %>

      <% if @celebraciones.any? %>
        <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
          <ul class="card-body divide-y divide-base-200 !gap-0 !py-2">
            <% @celebraciones.each do |celebracion| %>
              <li class="flex items-center gap-3 py-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-volt/15 text-lg">
                  <%= celebracion.emoji %>
                </span>
                <span class="flex-1 text-sm"><%= celebracion.texto %></span>
                <span class="flex shrink-0 flex-col items-end gap-0.5">
                  <% if celebracion.detalle %>
                    <span class="badge badge-sm border-0 bg-volt/20 font-bold text-volt-d"><%= celebracion.detalle %></span>
                  <% end %>
                  <span class="text-xs text-steel-3"><%= l celebracion.fecha, format: :short %></span>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      <% elsif @participo %>
        <p class="px-1 text-sm text-steel-3">
          Aún no hay celebraciones. La primera marca o logro de la comunidad aparecerá aquí.
        </p>
      <% end %>

      <% if @participo %>
        <%= button_to "Dejar de compartir mis logros", novedades_participacion_path,
              method: :delete, class: "btn btn-ghost btn-xs self-start text-steel-3" %>
      <% end %>
    </section>
  <% end %>
</div>
