<% content_for :title, "Crear cuenta — #{Negocio.nombre}" %>

<div class="relative min-h-screen overflow-hidden bg-base-200">
  <div class="pointer-events-none absolute -left-40 -top-40 size-[600px] rounded-full"
       style="background: radial-gradient(circle, rgba(180,240,0,0.10) 0%, transparent 70%)"></div>
  <div class="pointer-events-none absolute -bottom-40 -right-20 size-[500px] rounded-full"
       style="background: radial-gradient(circle, rgba(14,165,233,0.08) 0%, transparent 70%)"></div>
  <div class="trama-puntos pointer-events-none absolute inset-0 opacity-40"></div>

  <div class="relative flex min-h-screen lg:grid lg:grid-cols-[1fr_480px]">

    <%# Panel marca — solo desktop %>
    <div class="hidden lg:flex lg:flex-col lg:justify-between lg:p-14">
      <div class="flex items-center gap-3">
        <% if Current.tenant&.logo&.attached? %>
          <%= image_tag Current.tenant.logo.variant(resize_to_limit: [40, 40]),
                class: "size-10 rounded-xl object-contain ring-1 ring-white/10", alt: Negocio.nombre %>
        <% else %>
          <span class="flex size-10 items-center justify-center rounded-xl bg-white/10 ring-1 ring-white/15">
            <%= render "shared/logo", clase: "h-5 w-5 text-white" %>
          </span>
        <% end %>
        <span class="font-display text-sm font-bold tracking-[0.18em] text-white"><%= Negocio.nombre.upcase %></span>
        <span class="size-1.5 rounded-full" style="background:#b4f000"></span>
      </div>
      <div class="max-w-md">
        <h2 class="animate-fade-up font-display text-4xl font-bold leading-[1.15] text-white xl:text-5xl">
          El gimnasio que<br><span class="text-volt">te entiende.</span>
        </h2>
        <p class="animate-fade-up fade-delay-1 mt-4 text-sm leading-relaxed text-white/60">
          Crea tu cuenta, registra tus medidas y empieza a ver resultados reales desde el primer día.
        </p>
      </div>
      <p class="text-xs text-white/25">© <%= Date.current.year %> <%= Negocio.nombre %></p>
    </div>

    <%# Formulario %>
    <div class="flex min-h-screen items-center justify-center px-5 py-12 lg:bg-black/20 lg:backdrop-blur-xl lg:border-l lg:border-white/8">
      <div class="w-full max-w-sm animate-fade-up">

        <div class="mb-8 flex flex-col items-center gap-3 lg:hidden">
          <% if Current.tenant&.logo&.attached? %>
            <%= image_tag Current.tenant.logo.variant(resize_to_limit: [64, 64]),
                  class: "size-16 rounded-2xl object-contain ring-1 ring-white/15 shadow-lg", alt: Negocio.nombre %>
          <% else %>
            <span class="flex size-16 items-center justify-center rounded-2xl bg-white/8 ring-1 ring-white/15 shadow-lg">
              <%= render "shared/logo", clase: "h-8 w-8 text-white" %>
            </span>
          <% end %>
          <div class="flex items-center gap-2">
            <span class="font-display text-sm font-bold tracking-[0.18em] text-white"><%= Negocio.nombre.upcase %></span>
            <span class="size-1.5 rounded-full" style="background:#b4f000"></span>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-7 shadow-2xl backdrop-blur-xl">
          <div class="mb-6">
            <h1 class="font-display text-2xl font-bold text-white">Crea tu cuenta</h1>
            <p class="mt-1 text-sm text-white/50">Empieza a registrar tu progreso hoy</p>
          </div>

          <% if @user.errors.any? %>
            <div class="mb-4 flex items-start gap-2.5 rounded-xl border border-error/30 bg-error/10 p-3 text-sm text-error">
              <%= render "shared/icono", nombre: :alerta, clase: "size-4 mt-0.5 shrink-0" %>
              <span><%= @user.errors.full_messages.to_sentence %></span>
            </div>
          <% end %>

          <%= form_with model: @user, url: registro_path, class: "flex flex-col gap-4" do |form| %>
            <% [
              [:nombre, "Nombre completo", "text", "name", "Nombre y apellido"],
              [:email_address, "Correo electrónico", "email", "username", "tu@correo.com"],
              [:password, "Contraseña", "password", "new-password", "Mínimo 8 caracteres"],
              [:password_confirmation, "Confirma tu contraseña", "password", "new-password", "Repite la contraseña"]
            ].each_with_index do |(campo, etiqueta, tipo, autocomp, ph), i| %>
              <div>
                <label class="mb-1.5 block text-xs font-semibold text-white/70"><%= etiqueta %></label>
                <%= form.public_send(:"#{tipo}_field", campo,
                      required: true, autofocus: (i == 0), autocomplete: autocomp,
                      placeholder: ph, minlength: (campo == :password ? 8 : nil), maxlength: (campo.to_s.include?("password") ? 72 : nil),
                      class: "w-full rounded-xl border border-white/15 bg-white/8 px-4 py-2.5 text-sm text-white placeholder-white/30 outline-none ring-0 transition focus:border-volt/50 focus:bg-white/10 focus:ring-2 focus:ring-volt/20") %>
              </div>
            <% end %>

            <%= form.submit "Crear cuenta",
                  class: "mt-1 w-full cursor-pointer rounded-xl py-2.5 text-sm font-bold text-steel-9 shadow-[0_0_24px_rgba(180,240,0,0.2)] transition active:scale-[0.98]",
                  style: "background: linear-gradient(135deg, #8fbf00 0%, #b4f000 60%, #d3ff4d 100%)" %>
          <% end %>

          <p class="mt-5 text-center text-xs text-white/35">
            ¿Ya tienes cuenta?
            <%= link_to "Inicia sesión", new_session_path,
                  class: "font-semibold transition hover:opacity-80", style: "color:#b4f000" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
