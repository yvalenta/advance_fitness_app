<% content_for :title, "Solicitudes — Portal comercial" %>

<%= render "shared/encabezado",
      titulo: "Solicitudes de autoservicio",
      descripcion: "Leads de trainer.ynt.codes/entrena.ynt.codes (§17.5) — cobro manual, cerrar y crear el tenant/usuario desde Tenants.",
      accion: link_to("Ver tenants", superadmin_tenants_path, class: "btn btn-ghost font-bold text-white") %>

<div class="mx-auto -mt-8 w-full max-w-6xl px-4 pb-12">
  <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
    <div class="card-body">
      <% if @solicitudes.any? %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr class="text-xs uppercase text-steel-3">
                <th>Quién</th>
                <th class="hidden md:table-cell">Segmento</th>
                <th class="hidden md:table-cell">Contacto</th>
                <th class="hidden md:table-cell">Recibida</th>
                <th class="text-right">Estado</th>
              </tr>
            </thead>
            <tbody>
              <% @solicitudes.each do |s| %>
                <tr>
                  <td>
                    <p class="font-semibold"><%= s.nombre %></p>
                    <p class="text-xs text-steel-5"><%= s.negocio_nombre.presence || "—" %></p>
                    <div class="mt-1 flex flex-wrap items-center gap-1.5 md:hidden">
                      <span class="badge badge-ghost badge-sm"><%= s.segmento %></span>
                      <span class="text-xs text-steel-3"><%= s.email %> · <%= s.telefono %></span>
                    </div>
                  </td>
                  <td class="hidden md:table-cell"><span class="badge badge-ghost badge-sm"><%= s.segmento %></span></td>
                  <td class="hidden text-sm text-steel-5 md:table-cell">
                    <p><%= s.email %></p>
                    <p class="font-mono text-xs"><%= s.telefono %></p>
                  </td>
                  <td class="hidden text-sm text-steel-5 md:table-cell"><%= l(s.created_at, format: :short) %></td>
                  <td class="text-right">
                    <% if s.atendida? %>
                      <span class="badge badge-success badge-sm">atendida</span>
                    <% else %>
                      <%= button_to "Marcar atendida", superadmin_solicitud_autoservicio_path(s), method: :patch,
                            class: "btn btn-ghost btn-xs" %>
                    <% end %>
                  </td>
                </tr>
                <% if s.mensaje.present? %>
                  <tr class="md:hidden">
                    <td colspan="2" class="pt-0 text-xs text-steel-5">"<%= s.mensaje %>"</td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-12 text-center text-sm text-steel-3">Aún no hay solicitudes. Cuando alguien se registre en trainer.ynt.codes/entrena.ynt.codes aparecerá aquí.</p>
      <% end %>
    </div>
  </div>
</div>
