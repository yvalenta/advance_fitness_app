<% content_for :title, "Membresías — #{Negocio.nombre}" %>

<%= render "shared/encabezado",
      titulo: "Membresías",
      descripcion: "Altas, renovaciones y estado de cada plan mensual.",
      accion: link_to(new_admin_membresia_path, class: "btn btn-primary font-bold") { "Nueva membresía" } %>

<div class="mx-auto -mt-8 w-full max-w-6xl px-4 pb-12">
  <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
    <div class="card-body">
      <%# Form FUERA del frame (Fase 18p, bug reportado): el frame se
          recarga con cada busqueda y adentro se llevaba el input — foco y
          letras perdidas a mitad de tecleo. %>
      <div data-controller="buscador-en-vivo">
        <%= form_with url: admin_membresias_path, method: :get, class: "mb-1",
              data: { turbo_frame: "resultados_membresias", buscador_en_vivo_target: "form" } do %>
          <label class="input input-bordered flex max-w-sm items-center gap-2">
            <%= render "shared/icono", nombre: :busqueda, clase: "size-4 text-steel-3" %>
            <input type="search" name="q" value="<%= @q %>" placeholder="Buscar por nombre o correo…"
                   class="grow" data-action="input->buscador-en-vivo#buscar" data-buscador-en-vivo-target="entrada">
          </label>
        <% end %>
        <%= turbo_frame_tag "resultados_membresias" do %>

        <% if @q.present? %>
          <p class="text-xs text-steel-3">
            <%= pluralize(@membresias.total_count, "resultado") %> para "<%= @q %>" ·
            <%= link_to "Limpiar", admin_membresias_path, data: { turbo_frame: "resultados_membresias", action: "buscador-en-vivo#limpiar" }, class: "link" %>
          </p>
        <% end %>

        <% if @membresias.any? %>
          <div class="overflow-x-auto">
            <table class="table">
              <%# Responsive (Fase 18g): móvil = tarjeta en la primera celda. %>
              <thead>
                <tr class="text-xs uppercase tracking-wider text-steel-3">
                  <th>Miembro</th><th class="hidden md:table-cell">Estado</th><th class="hidden md:table-cell">Vence</th><th class="hidden md:table-cell">Días</th><th class="hidden md:table-cell">Horario</th><th></th>
                </tr>
              </thead>
              <tbody>
                <% @membresias.each do |membresia| %>
                  <tr class="hover:bg-base-200">
                    <td>
                      <%= link_to admin_user_path(membresia.user), data: { turbo_frame: "_top" }, class: "flex items-center gap-3 hover:underline" do %>
                        <%= render "shared/avatar", user: membresia.user %>
                        <div class="min-w-0">
                          <p class="font-semibold"><%= nombre_visible(membresia.user) %></p>
                          <p class="truncate text-xs text-steel-3"><%= membresia.user.email_address %></p>
                        </div>
                      <% end %>
                      <div class="mt-1.5 flex flex-wrap items-center gap-1 md:hidden">
                        <%= badge_estado(membresia.estado) %>
                        <span class="text-xs <%= membresia.dias_restantes.negative? ? "font-bold text-pulse" : "text-steel-3" %>">
                          <%= membresia.dias_restantes %> días · vence <%= l membresia.fecha_vencimiento, format: :short %>
                        </span>
                      </div>
                    </td>
                    <td class="hidden md:table-cell"><%= badge_estado(membresia.estado) %></td>
                    <td class="hidden text-sm text-steel-5 md:table-cell"><%= l membresia.fecha_vencimiento %></td>
                    <td class="hidden font-display font-bold md:table-cell <%= membresia.dias_restantes.negative? ? "text-pulse" : "" %>">
                      <%= membresia.dias_restantes %>
                    </td>
                    <td class="hidden text-xs text-steel-3 md:table-cell">
                      <%= membresia.hora_apertura ? "#{membresia.hora_apertura}–#{membresia.hora_cierre}" : "libre" %>
                    </td>
                    <td class="text-right">
                      <%= link_to "Gestionar", edit_admin_membresia_path(membresia), data: { turbo_frame: "_top" }, class: "btn btn-ghost btn-xs" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <%= render "shared/paginacion", coleccion: @membresias, frame: "resultados_membresias", q: @q,
                ruta: ->(params) { admin_membresias_path(**params) } %>
        <% else %>
          <div class="flex flex-col items-center gap-3 rounded-xl bg-base-200 py-12 text-center">
            <%= render "shared/icono", nombre: :escudo, clase: "size-8 text-steel-1" %>
            <p class="text-sm text-steel-3"><%= @q.present? ? "Nada coincide con tu búsqueda." : "Aún no hay membresías." %></p>
            <% unless @q.present? %>
              <%= link_to "Crear la primera", new_admin_membresia_path, class: "btn btn-primary btn-sm font-bold" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      </div>
    </div>
  </div>
</div>
