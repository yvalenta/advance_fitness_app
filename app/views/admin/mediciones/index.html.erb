<% content_for :title, "Mediciones — #{Negocio.nombre}" %>

<%= render "shared/encabezado",
      eyebrow: "Antropometría",
      titulo: "Mediciones de #{nombre_visible(@miembro)}",
      descripcion: "Historial de medidas tomadas en el gimnasio.",
      accion: link_to("Nueva medición", new_admin_user_medicion_path(@miembro), class: "btn btn-primary btn-sm font-bold") %>

<div class="mx-auto -mt-8 w-full max-w-4xl px-4 pb-12">
  <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
    <div class="card-body">
      <% if @mediciones.any? %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <%# Responsive (Fase 18g): en móvil fecha + peso/IMC apilados. %>
            <thead>
              <tr class="text-xs uppercase tracking-wider text-steel-3">
                <th>Fecha</th><th class="hidden md:table-cell">Peso</th><th class="hidden md:table-cell">IMC</th><th class="hidden md:table-cell">Grasa</th><th class="hidden lg:table-cell">Cintura</th><th class="hidden lg:table-cell">Tomada por</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% @mediciones.each do |medicion| %>
                <tr class="hover:bg-base-200">
                  <td>
                    <p class="font-medium"><%= l medicion.fecha %></p>
                    <p class="mt-0.5 text-xs text-steel-5 md:hidden">
                      <strong class="font-display text-sm text-base-content"><%= medicion.peso_kg %> kg</strong>
                      <% if medicion.imc %> · IMC <%= medicion.imc %><% end %>
                      <% if medicion.grasa_pct %> · <%= medicion.grasa_pct %>% grasa<% end %>
                    </p>
                  </td>
                  <td class="hidden md:table-cell"><%= medicion.peso_kg %> kg</td>
                  <td class="hidden md:table-cell"><%= medicion.imc || "—" %></td>
                  <td class="hidden md:table-cell"><%= medicion.grasa_pct ? "#{medicion.grasa_pct}%" : "—" %></td>
                  <td class="hidden lg:table-cell"><%= medicion.cintura_cm ? "#{medicion.cintura_cm} cm" : "—" %></td>
                  <td class="hidden text-steel-3 lg:table-cell"><%= medicion.tomada_por ? nombre_visible(medicion.tomada_por) : "el miembro" %></td>
                  <td class="text-right"><%= link_to "Editar", edit_admin_user_medicion_path(@miembro, medicion), class: "btn btn-ghost btn-xs" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="flex flex-col items-center gap-2 rounded-xl bg-base-200 py-10 text-center">
          <%= render "shared/icono", nombre: :actividad, clase: "size-8 text-steel-1" %>
          <p class="text-sm text-steel-3">Aún no hay mediciones para este miembro.</p>
          <%= link_to "Tomar la primera", new_admin_user_medicion_path(@miembro), class: "btn btn-primary btn-sm font-bold" %>
        </div>
      <% end %>

      <%= link_to "← Volver al miembro", admin_user_path(@miembro), class: "btn btn-ghost btn-sm mt-2 self-start" %>
    </div>
  </div>
</div>
