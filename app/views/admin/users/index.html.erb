<% content_for :title, "Miembros — #{Negocio.nombre}" %>

<%= render "shared/encabezado",
      titulo: "Miembros",
      descripcion: "Todas las personas registradas en el gimnasio.",
      accion: (policy(User).create? ? link_to("Agregar persona", new_admin_user_path, class: "btn btn-primary font-bold") : nil) %>

<div class="mx-auto -mt-8 w-full max-w-6xl px-4 pb-12">
  <div class="card animate-fade-up border border-base-300 bg-base-100 shadow-md">
    <div class="card-body">
      <%# Form FUERA del frame (Fase 18p, bug reportado): el frame se
          recarga con cada busqueda y adentro se llevaba el input — foco y
          letras perdidas a mitad de tecleo. %>
      <div data-controller="buscador-en-vivo">
        <%= form_with url: admin_users_path, method: :get, class: "mb-1",
              data: { turbo_frame: "resultados_miembros", buscador_en_vivo_target: "form" } do %>
          <label class="input input-bordered flex max-w-sm items-center gap-2">
            <%= render "shared/icono", nombre: :busqueda, clase: "size-4 text-steel-3" %>
            <input type="search" name="q" value="<%= @q %>" placeholder="Buscar por nombre o correo…"
                   class="grow" data-action="input->buscador-en-vivo#buscar" data-buscador-en-vivo-target="entrada">
          </label>
        <% end %>
        <%= turbo_frame_tag "resultados_miembros" do %>

        <% if @q.present? %>
          <p class="text-xs text-steel-3">
            <%= pluralize(@users.total_count, "resultado") %> para "<%= @q %>" ·
            <%= link_to "Limpiar", admin_users_path, data: { turbo_frame: "resultados_miembros", action: "buscador-en-vivo#limpiar" }, class: "link" %>
          </p>
        <% end %>

        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <%# Responsive (Fase 18g): móvil = tarjeta en la primera celda. %>
              <tr class="text-xs uppercase tracking-wider text-steel-3">
                <th>Miembro</th><th class="hidden md:table-cell">Rol</th><th class="hidden md:table-cell">Membresía</th><th class="hidden md:table-cell">Ingreso</th><th></th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |usuario| %>
                <tr class="hover:bg-base-200">
                  <td>
                    <%= link_to admin_user_path(usuario), data: { turbo_frame: "_top" }, class: "flex items-center gap-3 hover:underline" do %>
                      <%= render "shared/avatar", user: usuario %>
                      <div class="min-w-0">
                        <p class="font-semibold"><%= usuario.nombre.presence || "—" %></p>
                        <p class="truncate text-xs text-steel-3"><%= usuario.email_address %></p>
                      </div>
                    <% end %>
                    <%# El rol mostrado es el del PUESTO en este gimnasio (alias
                        rol_del_puesto del select del controller); usuario.rol es
                        la cache del tenant donde la cuenta está estacionada. %>
                    <div class="mt-1.5 flex flex-wrap items-center gap-1 md:hidden">
                      <% unless usuario[:rol_del_puesto] == "miembro" %>
                        <span class="badge badge-sm badge-ghost"><%= usuario[:rol_del_puesto] %></span>
                      <% end %>
                      <% if usuario.membresia %>
                        <%= badge_estado(usuario.membresia.estado) %>
                      <% else %>
                        <span class="text-xs text-steel-3">sin membresía</span>
                      <% end %>
                    </div>
                  </td>
                  <td class="hidden md:table-cell"><span class="badge badge-sm badge-ghost"><%= usuario[:rol_del_puesto] %></span></td>
                  <td class="hidden md:table-cell">
                    <% if usuario.membresia %>
                      <%= badge_estado(usuario.membresia.estado) %>
                    <% else %>
                      <span class="text-xs text-steel-3">sin membresía</span>
                    <% end %>
                  </td>
                  <td class="hidden text-sm text-steel-5 md:table-cell"><%= l usuario.fecha_ingreso %></td>
                  <td class="text-right">
                    <div class="flex items-center justify-end gap-1">
                      <%= link_to admin_user_path(usuario), class: "btn btn-ghost btn-xs btn-square tooltip", "data-tip": "Ver perfil", data: { turbo_frame: "_top" } do %>
                        <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.574-3.007-9.964-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
                      <% end %>
                      <% if policy(usuario).update? %>
                        <%= link_to edit_admin_user_medicion_path(usuario, usuario.mediciones.order(fecha: :desc).first || 0), class: "btn btn-ghost btn-xs btn-square tooltip", "data-tip": "Nueva medición", data: { turbo_frame: "_top" } do %>
                          <%= render "shared/icono", nombre: :lapiz, clase: "size-4" %>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%= render "shared/paginacion", coleccion: @users, frame: "resultados_miembros", q: @q,
              ruta: ->(params) { admin_users_path(**params) } %>
      <% end %>
      </div>
    </div>
  </div>
</div>
