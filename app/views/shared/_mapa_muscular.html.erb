<%# Mapa muscular (Juego::MapaMuscular): volumen entrenado por grupo, sobre
    dos siluetas ESQUEMÁTICAS (frente/espalda) — no anatómicas, coherentes
    con el estilo stencil de la marca (SDD §06). Geometría en
    ApplicationHelper#zonas_mapa_muscular_frente/_espalda. %>
<%# locals: (progreso:, periodo:) %>
<% datos = progreso.mapa_muscular %>
<div class="card border border-base-300 bg-base-100 shadow-md">
  <div class="card-body">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="card-title text-base">
        <span class="flex size-7 items-center justify-center rounded-lg bg-base-200 text-steel-5">
          <%= render "shared/icono", nombre: :actividad, clase: "size-4" %>
        </span>
        Mapa muscular
      </h2>
      <div class="join">
        <% { semana: "Semana", mes: "Mes", todo: "Todo" }.each do |valor, etiqueta| %>
          <%= link_to etiqueta, progreso_grafica_path(tipo: "mapa_muscular", periodo: valor),
                class: "btn btn-xs join-item #{"btn-active" if periodo == valor}" %>
        <% end %>
      </div>
    </div>

    <% if datos[:por_musculo].values.sum.positive? %>
      <div class="relative mt-2 flex flex-wrap justify-center gap-8" data-controller="grafica"
           data-action="mousemove->grafica#mostrar mouseleave->grafica#ocultar">
        <% [ [ "Frente", zonas_mapa_muscular_frente ], [ "Espalda", zonas_mapa_muscular_espalda ] ].each do |titulo, zonas| %>
          <div class="flex flex-col items-center gap-1">
            <svg viewBox="0 0 120 230" width="120" height="230" role="img" aria-label="Mapa muscular — <%= titulo %>">
              <circle cx="60" cy="20" r="15" fill="var(--color-steel-1)" />
              <% zonas.each do |zona| %>
                <% intensidad = datos[:intensidad][zona[:musculo]].to_f %>
                <% volumen = datos[:por_musculo][zona[:musculo]].to_f %>
                <%= tag.public_send(zona[:forma], **zona[:atributos],
                      fill: "var(--color-volt)", "fill-opacity": [ intensidad, 0.08 ].max,
                      data: { etiqueta: "#{PlantillaEjercicio::NOMBRES_MUSCULO[zona[:musculo]]} — #{volumen.round} kg" }) %>
              <% end %>
            </svg>
            <span class="text-xs font-semibold text-steel-3"><%= titulo %></span>
          </div>
        <% end %>
        <div class="pointer-events-none absolute z-10 -translate-x-1/2 whitespace-nowrap rounded-lg bg-steel px-2.5 py-1 text-xs font-semibold text-volt-d shadow-lg"
             hidden data-grafica-target="tooltip"></div>
      </div>

      <% if datos[:sin_trabajar].any? %>
        <p class="mt-3 text-xs text-steel-3">
          Sin trabajar en este período: <%= datos[:sin_trabajar].map { |musculo| PlantillaEjercicio::NOMBRES_MUSCULO[musculo] }.to_sentence %>.
        </p>
      <% end %>
      <% if datos[:por_musculo]["otro"].to_f.positive? %>
        <p class="mt-1 text-xs text-steel-3">
          + <%= datos[:por_musculo]["otro"].round %> kg en ejercicios sin músculo asignado.
        </p>
      <% end %>
    <% else %>
      <div class="mt-2 flex flex-col items-center gap-2 rounded-xl bg-base-200 py-10 text-center">
        <%= render "shared/icono", nombre: :actividad, clase: "size-8 text-steel-1" %>
        <p class="text-sm text-steel-3">Registra series en tus sesiones para ver qué músculos trabajaste.</p>
      </div>
    <% end %>
  </div>
</div>
