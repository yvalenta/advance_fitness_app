<%# Racha de entrenamiento (Fase 14.5): días consecutivos desde el
    PerfilJuego del miembro — proyección de solo lectura del motor de juego
    (Fase 14.12). `perfil` puede venir sin persistir (find_or_initialize):
    los defaults de columna (racha 0) pintan el estado apagado. %>
<%# locals: (perfil:, dias: nil) %>
<% encendida = perfil.racha_actual.to_i.positive? %>
<div class="card card-hover border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body gap-1.5">
    <div class="flex items-start justify-between">
      <h2 class="eyebrow text-steel-3">Racha</h2>
      <span class="flex size-9 items-center justify-center rounded-xl <%= encendida ? "bg-volt/15 text-volt-d" : "bg-base-200 text-steel-3" %>">
        <%= render "shared/icono", nombre: :fuego, clase: "size-4.5" %>
      </span>
    </div>
    <span class="font-display text-4xl font-bold tracking-tight <%= "text-volt-d" if encendida %>">
      <%= perfil.racha_actual.to_i %><span class="ml-1 text-base font-semibold text-steel-5">días</span>
    </span>

    <%# Tira de la semana (Fase 16.4, referencia Pulse): un marcador por día
        L–D; cumplido = check-in o ejercicio marcado (regla de Juego::Racha).
        Solo la pinta el dashboard, que trae los datos — la vista no consulta. %>
    <% if dias %>
      <div class="mt-1 flex items-end justify-between gap-1" aria-hidden="true">
        <% letras = %w[L M X J V S D] %>
        <% dias.each_with_index do |dia, indice| %>
          <div class="flex flex-1 flex-col items-center gap-1">
            <span class="w-1.5 rounded-full <%= dia[:cumplido] ? "h-6 bg-volt" : "h-6 #{dia[:futuro] ? "bg-base-300/50" : "bg-base-300"}" %>"></span>
            <span class="text-[9px] font-bold <%= dia[:fecha] == Date.current ? "text-volt-d" : "text-steel-5" %>"><%= letras[indice] %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <p class="text-sm text-steel-5">
      <% if perfil.racha_mejor.to_i.positive? %>
        Mejor racha: <%= perfil.racha_mejor.to_i %> días
      <% else %>
        Entrena hoy y enciéndela
      <% end %>
    </p>

    <%# Web Push (Fase 15): opt-in del recordatorio de racha para ESTE
        dispositivo. El estado real vive en el navegador (permiso +
        suscripción), así que la zona nace oculta y push_controller la
        revela ya resuelta — sin flash de estado equivocado. %>
    <% if ENV["VAPID_PUBLIC_KEY"].present? %>
      <div class="mt-1.5 hidden border-t border-base-300 pt-3"
           data-controller="push"
           data-push-target="zona"
           data-push-clave-value="<%= ENV["VAPID_PUBLIC_KEY"] %>"
           data-push-url-value="<%= suscripciones_push_path %>">
        <p class="hidden text-xs text-steel-5" data-push-target="pista">
          Instala la app en tu pantalla de inicio (Compartir → Agregar a inicio)
          para poder recibir recordatorios de racha.
        </p>
        <div class="hidden space-y-2" data-push-target="apagado">
          <p class="text-xs text-steel-5">Te avisamos a las 6pm si tu racha peligra.</p>
          <button type="button" data-action="push#activar"
                  class="btn btn-sm rounded-xl border-0 bg-volt font-semibold text-steel-9 hover:bg-volt/90">
            Activar
          </button>
        </div>
        <div class="hidden space-y-2" data-push-target="encendido">
          <p class="text-xs text-steel-5">
            <span class="text-volt-d">●</span> Recordatorio activo en este dispositivo
          </p>
          <button type="button" data-action="push#desactivar"
                  class="btn btn-ghost btn-sm rounded-xl text-steel-5">
            Quitar
          </button>
        </div>
      </div>
    <% end %>
  </div>
</div>
