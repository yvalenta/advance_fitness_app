<%# Paleta del tenant (SDD §16.6, unificada en Fase 16): overrides de los
    tokens CSS de marca. Solo colores hex (anti CSS-injection desde el jsonb).
    El selector `:root, [data-theme]` es deliberado (Nota 21d): el tema activo
    vive en `body[data-theme]` y sus tokens le ganarían a un override que solo
    apunte a :root — con ambos selectores, la paleta del tenant tiñe los DOS
    temas, incluidos los gradientes parametrizados con var(). %>
<% if Current.tenant&.paleta_colores.is_a?(Hash) && Current.tenant.paleta_colores.any? %>
  <style>
    :root, [data-theme] {
      <% Current.tenant.paleta_colores.each do |token, valor| %>
        <% if valor.to_s.match?(/\A#[0-9a-fA-F]{3,8}\z/) && %w[volt primary accent].include?(token.to_s) %>
          --color-<%= token %>: <%= valor %>;
          <% if token.to_s == "volt" %>
          --color-volt-d: color-mix(in srgb, <%= valor %> 70%, #000000);
          --color-volt-l: color-mix(in srgb, <%= valor %> 60%, #ffffff);
          <% end %>
        <% end %>
      <% end %>
    }
  </style>
<% end %>
